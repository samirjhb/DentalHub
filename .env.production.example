# Copia este archivo a .env.production y completa los valores reales.
# NUNCA subas .env.production al repositorio.

# Dominio público (registro DNS A apuntando al servidor). Caddy saca el HTTPS.
DOMAIN=tudominio.com
FRONTEND_URL=https://tudominio.com

# MongoDB — contraseña fuerte (mín. 16 caracteres, evita @ : / ? # en ella)
MONGO_DATABASE=dentalhub
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=

# Backend
JWT_SECRET=

# Cloudinary (radiografías / adjuntos clínicos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recuperación de contraseña (Resend)
RESEND_API_KEY=
RESEND_FROM=DentalHub <notificaciones@tudominio.com>
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Respaldos de Mongo (servicio mongo-backup)
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
